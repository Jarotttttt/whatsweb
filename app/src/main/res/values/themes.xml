<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WhatsWeb" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/whatsapp_teal</item>
        <item name="colorPrimaryDark">@color/whatsapp_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/whatsapp_light_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/whatsapp_green_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/whatsapp_green_dark</item>

        <!-- App Bar & Toolbar Styling -->
        <item name="appBarLayoutStyle">@style/Widget.WhatsWeb.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.WhatsWeb.Toolbar</item>
    </style>

    <style name="Widget.WhatsWeb.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/whatsapp_green</item>
    </style>

    <style name="Widget.WhatsWeb.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/whatsapp_green</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="actionMenuTextColor">@color/white</item>
    </style>
</resources>
