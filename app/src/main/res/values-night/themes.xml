<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WhatsWeb" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dark Mode Colors -->
        <item name="colorPrimary">@color/whatsapp_dark_teal</item>
        <item name="colorPrimaryDark">@color/whatsapp_dark_background</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/whatsapp_dark_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/whatsapp_dark_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/whatsapp_dark_background</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/whatsapp_dark_background</item>

        <!-- App Bar & Toolbar Styling -->
        <item name="appBarLayoutStyle">@style/Widget.WhatsWeb.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.WhatsWeb.Toolbar</item>
    </style>

    <style name="Widget.WhatsWeb.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/whatsapp_dark_surface</item>
    </style>

    <style name="Widget.WhatsWeb.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/whatsapp_dark_surface</item>
        <item name="titleTextColor">@color/whatsapp_dark_text_primary</item>
        <item name="subtitleTextColor">@color/whatsapp_dark_text_secondary</item>
        <item name="colorControlNormal">@color/whatsapp_dark_text_primary</item>
        <item name="actionMenuTextColor">@color/whatsapp_dark_text_primary</item>
    </style>
</resources>
